# .env.example
# The Gemini API Key is required for the server-side AI-powered capabilities (e.g. ERPNext simulation assistance).
# Do NOT prefix with VITE_ to keep it secure on the server side.
GEMINI_API_KEY=

# Persistence Mode for Frontend: 'local' (default) or 'api'
VITE_PERSISTENCE_MODE=local

# Database Provider: 'pglite' (default for standalone/test) or 'postgres'
DATABASE_PROVIDER=pglite

# PostgreSQL Database Connection String
DATABASE_URL=postgresql://username:password@localhost:5432/novaro_erp

# Phase 2D Identity & Security Configuration
JWT_SECRET=novaro-production-jwt-secret-key-change-in-prod-2026
JWT_REFRESH_SECRET=novaro-production-jwt-refresh-secret-key-change-in-prod-2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
